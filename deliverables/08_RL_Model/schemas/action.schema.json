{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rl_model/action/1.0",
  "title": "Action response (Python -> Java)",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "type", "task_id", "action_id", "action", "model_version"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "type": {"const": "action"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "action_id": {"enum": [0, 1, 2]},
    "action": {"enum": ["Local", "Edge", "Cloud"]},
    "model_version": {"type": "string"},
    "state_index": {"type": "integer", "minimum": 0},
    "mode": {"enum": ["explore", "exploit", "greedy", "fallback", "baseline"]},
    "epsilon": {"type": "number", "minimum": 0, "maximum": 1},
    "q_values": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
  }
}
