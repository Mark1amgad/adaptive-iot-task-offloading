{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rl_model/outcome/1.0",
  "title": "Post-execution outcome (Java -> Python), sent AFTER the task finished or failed",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "type", "task_id", "action_executed", "status", "deadline_met", "resource_metrics"],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "type": {"const": "outcome"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "action_executed": {"enum": ["Local", "Edge", "Cloud"], "description": "what Java really executed"},
    "status": {"enum": ["completed", "failed"]},
    "failure_reason": {"type": "string"},
    "latency_ms": {"type": ["number", "null"], "minimum": 0, "description": "measured end-to-end latency; required when completed"},
    "deadline_met": {"type": "boolean", "description": "false whenever status=failed"},
    "resource_metrics": {
      "type": "object",
      "additionalProperties": {"type": ["number", "null"], "minimum": 0},
      "properties": {
        "bandwidth_bytes": {"type": ["number", "null"], "minimum": 0},
        "energy_joules": {"type": ["number", "null"], "minimum": 0},
        "executing_node_utilization": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "terminal": {"type": "boolean", "default": true},
    "next_observation": {
      "type": "object", "additionalProperties": false, "required": ["features"],
      "properties": {"features": {"type": "object"}, "available_actions": {"type": "array"}},
      "description": "Only with terminal=false and decision_model=sequential."
    },
    "sim_time_ms": {"type": "number", "minimum": 0}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "completed"}}},
     "then": {"required": ["latency_ms"], "properties": {"latency_ms": {"type": "number"}}}},
    {"if": {"properties": {"status": {"const": "failed"}}},
     "then": {"properties": {"deadline_met": {"const": false}}}}
  ]
}
